   "segs": [
    {
     "say": "An order block is a price zone where large market participants have likely placed a lot of orders. On the chart, it's easy to spot.",
     "step": -1
    },
    {
     "say": "Gold falls over several candles.",
     "step": 0
    },
    {
     "say": "Then the market turns up with a powerful impulse. A move like that rarely happens by chance.",
     "step": 1,
     "point": "Strong *impulse* up"
    },
    {
     "say": "The last red candle before this impulse is the bullish order block. This is where buying started – and there are often still orders waiting there.",
     "step": 2,
     "point": "Last red candle = *order block*"
    },
    {
     "say": "Later, price comes back into exactly this zone. That's called the test, or mitigation, of the order block.",
     "step": 3,
     "point": "Pullback into the *zone*"
    },
    {
     "say": "And here the market reacts higher again. A bearish order block is the mirror image: the last green candle before a strong sell-off.",
     "step": 4,
     "point": "Bearish: *last green* candle"
    }
   ]
  },
