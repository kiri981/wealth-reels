   "segs": [
    {
     "say": "A particularly strong magnet is equal highs and equal lows. Many traders see them as safe resistance. In reality it's often the opposite.",
     "step": -1
    },
    {
     "say": "Here gold rises and forms a high.",
     "step": 0
    },
    {
     "say": "After a pullback, price runs right back up to the same level – and turns away again. A textbook double top.",
     "step": 1,
     "point": "Two highs at the *same* level"
    },
    {
     "say": "Now there are twice as many stops and breakout orders above this line. The cleaner the highs, the more liquidity builds up there.",
     "step": 2,
     "point": "Equal highs = *liquidity*"
    },
    {
     "say": "And then it happens: a wick shoots above the highs, takes the stops – but the candle closes back below. The breakout buyers are trapped.",
     "step": 3,
     "point": "Wick above, *close* below"
    },
    {
     "say": "Shortly after, price breaks below the last low. A break of structure to the downside confirms that the sellers have taken over.",
     "step": 4,
     "point": "BOS down = *confirmation*"
    },
    {
     "say": "The sell-off often keeps going until it reaches the next liquidity below. With equal lows, it works exactly the other way round.",
     "step": 5
    }
   ]
