   "segs": [
    {
     "say": "Of course, not every break above a high is a sweep. Sometimes the breakout is real. So the key question is: how do you tell the difference?",
     "step": -1
    },
    {
     "say": "Again we see several highs at the same level. Here too, liquidity sits above the line.",
     "step": 0
    },
    {
     "say": "This time a candle with a big body closes clearly above the highs. No long wick, no quick drop back.",
     "step": 1,
     "point": "Breakout: clear *candle close*"
    },
    {
     "say": "Price comes back to the old line but stays above it. The former resistance now holds as support. That's called a retest.",
     "step": 2,
     "point": "Retest: old line *holds*"
    },
    {
     "say": "After that, the move continues. That's the difference: with a sweep, price returns quickly. With a real breakout, it closes above and holds the level.",
     "step": 3,
     "point": "Sweep reverses, breakout *holds*"
    },
    {
     "say": "If you're unsure, wait. One or two candles of patience cost you little – an entry in the wrong direction costs more.",
     "step": 3
    }
   ]
