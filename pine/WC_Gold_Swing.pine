//@version=5
// WC Gold Swing – Wealth Club (Tageschart)
// Trendfilter: Schluss > SMA200 und SMA50 > SMA200 (nur Long).
// Einstieg A: Schluss über dem 55-Tage-Hoch.  Einstieg B: Rücksetzer an die SMA50 (Tief berührt sie in den letzten 3 Tagen) + Schluss über Vortageshoch.
// Einstieg zur nächsten Tageseröffnung, SL 2 x ATR(20), Ausstieg wenn Schluss unter dem 20-Tage-Tief (nächste Eröffnung).
// Lernzwecke – keine Anlageberatung.
indicator("WC Gold Swing", shorttitle="WC Swing", overlay=true, max_labels_count=500, max_lines_count=500)

useA   = input.bool(true, "Einstieg A: 55-Tage-Ausbruch")
useB   = input.bool(true, "Einstieg B: Rücksetzer an SMA50")
kATR   = input.float(2.0, "Stop-Loss (x ATR20)", step=0.5)
exitN  = input.int(20, "Ausstieg: Schluss unter X-Tage-Tief")
cost   = input.float(0.5, "Kosten pro Trade in $", step=0.1)
showT  = input.bool(true, "Statistik-Tabelle")

s20  = ta.sma(close, 20)
s50  = ta.sma(close, 50)
s200 = ta.sma(close, 200)
atr  = ta.atr(20)
trendUp = close > s200 and s50 > s200
brk  = close > ta.highest(high, 55)[1]
pull = (low <= s50 or low[1] <= s50[1] or low[2] <= s50[2]) and close > high[1]
exitSig = close < ta.lowest(low, exitN)[1]

plot(s50, "SMA50", color.new(color.orange, 20))
plot(s200, "SMA200", color.new(color.purple, 20), 2)
bgcolor(trendUp ? color.new(color.green, 94) : na)

var int   state = 0      // 0 frei, 1 Einstieg morgen, 2 Position, 3 Ausstieg morgen
var float ent = na
var float sl  = na
var float R   = na
var float pendR = na
var string typ = ""
var line  lS  = na
var int   nT = 0
var int   nW = 0
var float sumR = 0.0
var float peak = 0.0
var float dd   = 0.0

float exitPx = na
if state == 1
    ent   := open
    R     := pendR
    sl    := ent - R
    state := 2
    lS := line.new(bar_index, sl, bar_index + 1, sl, color=color.red, width=2)
    alert("WC Swing: LONG eröffnet @ " + str.tostring(ent, format.mintick) + " | SL " + str.tostring(sl, format.mintick), alert.freq_once_per_bar_close)
else if state == 3
    exitPx := open
if state == 2 and na(exitPx) and low <= sl
    exitPx := math.min(sl, open)
if not na(exitPx) and (state == 2 or state == 3)
    r = (exitPx - ent - cost) / R
    nT += 1
    nW += r > 0 ? 1 : 0
    sumR += r
    peak := math.max(peak, sumR)
    dd   := math.max(dd, peak - sumR)
    line.set_x2(lS, bar_index)
    label.new(bar_index, high, "Exit " + str.tostring(r, "+0.0;-0.0") + "R", style=label.style_label_down, color=color.new(r > 0 ? color.green : color.red, 20), textcolor=color.white, size=size.small)
    alert("WC Swing: Position geschlossen " + str.tostring(r, "+0.0;-0.0") + "R", alert.freq_once_per_bar_close)
    state := 0
else if state == 2
    line.set_x2(lS, bar_index + 1)
    if exitSig
        state := 3
        alert("WC Swing: Schluss unter " + str.tostring(exitN) + "-Tage-Tief – Ausstieg zur nächsten Eröffnung", alert.freq_once_per_bar_close)

if state == 0 and barstate.isconfirmed and trendUp
    sA = useA and brk
    sB = useB and pull and not sA
    if sA or sB
        typ   := sA ? "A" : "B"
        pendR := kATR * atr
        state := 1
        label.new(bar_index, low, "Swing " + typ + " ▲", style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white, size=size.small)
        alert("WC Swing: Einstieg " + typ + " – Long zur nächsten Eröffnung, SL ca. " + str.tostring(close - pendR, format.mintick), alert.freq_once_per_bar_close)

if showT and barstate.islast
    var table t = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_width=1)
    st = timeframe.isdaily ? (state == 2 ? "Long läuft" : trendUp ? "Aufwärtstrend – wartet" : "kein Trend – flat") : "Tageschart nutzen!"
    table.cell(t, 0, 0, "WC Gold Swing", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, st, text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 1, "Trades", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(nT), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "Trefferquote", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, nT > 0 ? str.tostring(100.0 * nW / nT, "0") + "%" : "-", text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "Ø R pro Trade", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, nT > 0 ? str.tostring(sumR / nT, "+0.00;-0.00") : "-", text_color=sumR >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 4, "Summe R", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(sumR, "+0.0;-0.0"), text_color=sumR >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 5, "Max. Drawdown R", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(dd, "0.0"), text_color=color.white, text_size=size.small)
