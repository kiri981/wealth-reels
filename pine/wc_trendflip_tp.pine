//@version=5
// WC Trend-Flip + TP  (Wealth Club, eigene Umsetzung)
// Idee: Trendwechsel über einen ATR-Trailing-Stopp (Supertrend-Prinzip). Ein Wechsel nach oben = Kauf-Idee, nach unten = Verkauf-Idee.
// „+“ = Wechsel in Richtung des übergeordneten Trends (Schluss über/unter EMA 200).
// Ziele TP1–TP3 = Einstieg ± k × ATR. Stopp = Trailing-Linie zum Zeitpunkt des Wechsels. Anders als viele Verkaufs-Indikatoren
// zeigt dieser auch die STOPPS – damit du siehst, wie er wirklich läuft. Statistik-Tabelle unten rechts.
// Nachtest Gold 5 Min. (Feb–Nov 2026, ~270 Tage, Hub-Daten): ATR 10 × 3 mit EMA-Filter → TP1 in ca. 80 % der Fälle,
// aber im Schnitt nur ca. +0,03 R je Trade (1/3 je Ziel, Stopp nach TP1 auf Einstand) – also kein Selbstläufer. Keine Anlageberatung.
indicator("WC Trend-Flip + TP", overlay = true, max_labels_count = 500, max_lines_count = 500)

atrLen   = input.int(10, "ATR-Länge", minval = 1)
factor   = input.float(3.0, "ATR-Faktor (Abstand der Trailing-Linie)", step = 0.1)
useFilt  = input.bool(true, "Nur Trade-Ideen in Trendrichtung (EMA-Filter)")
emaLen   = input.int(200, "EMA-Länge für den Filter")
tp1k     = input.float(1.0, "TP1 = × ATR", step = 0.1)
tp2k     = input.float(2.0, "TP2 = × ATR", step = 0.1)
tp3k     = input.float(3.0, "TP3 = × ATR", step = 0.1)
beAfter1 = input.bool(true, "Nach TP1 Stopp auf Einstand")
showLine = input.bool(true, "Trailing-Linie anzeigen")
showStat = input.bool(true, "Statistik-Tabelle anzeigen")

[st, dir] = ta.supertrend(factor, atrLen)   // dir < 0 = Aufwärtstrend, dir > 0 = Abwärtstrend (TradingView-Konvention)
a   = ta.atr(atrLen)
ema = ta.ema(close, emaLen)
plot(showLine ? st : na, "Trailing-Linie", color = dir < 0 ? color.new(color.teal, 0) : color.new(color.red, 0), linewidth = 1, style = plot.style_linebr)
plot(useFilt ? ema : na, "EMA", color = color.new(color.gray, 40))

flipUp = dir < 0 and dir[1] > 0
flipDn = dir > 0 and dir[1] < 0
strongUp = close > ema
strongDn = close < ema
goLong  = flipUp and (not useFilt or strongUp)
goShort = flipDn and (not useFilt or strongDn)

var int side = 0
var float e = na
var float sl = na
var float t1 = na
var float t2 = na
var float t3 = na
var int hits = 0
var int nTr = 0
var int nTp1 = 0
var int nTp2 = 0
var int nTp3 = 0
var int nSl = 0
var float sumR = 0.0
var float risk = na
var float realR = 0.0
pct(x, n) => n > 0 ? str.tostring(100.0 * x / n, "#") + " %" : "–"

// laufende Position verwalten (vor neuen Ideen)
if side != 0
    hitSl = side > 0 ? low <= sl : high >= sl
    if hitSl
        realR += (1.0 - hits / 3.0) * side * (sl - e) / risk
        sumR += realR
        nSl += hits == 0 ? 1 : 0
        label.new(bar_index, side > 0 ? low : high, hits == 0 ? "SL" : "BE", style = side > 0 ? label.style_label_up : label.style_label_down, color = hits == 0 ? color.new(color.red, 10) : color.new(color.gray, 10), textcolor = color.white, size = size.tiny)
        side := 0
    else
        for k = 0 to 2
            if hits > k
                continue
            tpx = k == 0 ? t1 : k == 1 ? t2 : t3
            reached = side > 0 ? high >= tpx : low <= tpx
            if not reached
                break
            realR += (1.0 / 3.0) * side * (tpx - e) / risk
            hits += 1
            label.new(bar_index, side > 0 ? high : low, "TP " + str.tostring(hits) + " ✓", style = side > 0 ? label.style_label_down : label.style_label_up, color = color.new(color.black, 10), textcolor = color.white, size = size.tiny)
            if hits == 1
                nTp1 += 1
                if beAfter1
                    sl := e
            if hits == 2
                nTp2 += 1
                sl := t1
            if hits == 3
                nTp3 += 1
        if hits == 3
            sumR += realR
            side := 0

// neue Idee (Trendwechsel) – offene Gegenposition wird zum Schlusskurs geschlossen
if goLong or goShort
    if side != 0
        realR += (1.0 - hits / 3.0) * side * (close - e) / risk
        sumR += realR
    side := goLong ? 1 : -1
    e := close
    sl := st
    risk := math.abs(e - sl)
    t1 := e + side * tp1k * a
    t2 := e + side * tp2k * a
    t3 := e + side * tp3k * a
    hits := 0
    realR := 0.0
    nTr += 1
    txt = (side > 0 ? "Kauf-Idee" : "Verkauf-Idee") + ((side > 0 ? strongUp : strongDn) ? " +" : "")
    label.new(bar_index, side > 0 ? low : high, txt, style = side > 0 ? label.style_label_up : label.style_label_down, color = side > 0 ? color.new(color.green, 0) : color.new(color.red, 0), textcolor = color.white, size = size.small)
    line.new(bar_index, t1, bar_index + 12, t1, color = color.new(color.teal, 30), style = line.style_dotted)
    line.new(bar_index, t2, bar_index + 12, t2, color = color.new(color.teal, 30), style = line.style_dotted)
    line.new(bar_index, t3, bar_index + 12, t3, color = color.new(color.teal, 30), style = line.style_dotted)
    line.new(bar_index, sl, bar_index + 12, sl, color = color.new(color.red, 30), style = line.style_dotted)

alertcondition(goLong,  "Kauf-Idee",    "WC Trend-Flip: Kauf-Idee")
alertcondition(goShort, "Verkauf-Idee", "WC Trend-Flip: Verkauf-Idee")

var table tb = table.new(position.bottom_right, 2, 6, bgcolor = color.new(color.black, 20), border_width = 1)
if showStat and barstate.islast
    table.cell(tb, 0, 0, "Ideen", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, str.tostring(nTr), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "TP1 / TP2 / TP3", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, pct(nTp1, nTr) + " / " + pct(nTp2, nTr) + " / " + pct(nTp3, nTr), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Stopp vor TP1", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, pct(nSl, nTr), text_color = color.red, text_size = size.small)
    table.cell(tb, 0, 3, "Ø Ergebnis je Idee", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, nTr > 0 ? str.tostring(sumR / nTr, "+0.00;-0.00") + " R" : "–", text_color = sumR >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(tb, 0, 4, "ohne Kosten/Spread", text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 1, 4, "keine Anlageberatung", text_color = color.gray, text_size = size.tiny)
